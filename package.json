{
  "name": "eslint-plugin-import-remap",
  "type": "module",
  "version": "1.0.1",
  "packageManager": "bun@1.4.0",
  "description": "Remap imports with ESLint autofixes.",
  "author": "Ilya Semenov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/eslint-plugin-import-remap.git"
  },
  "homepage": "https://github.com/IlyaSemenov/eslint-plugin-import-remap#readme",
  "bugs": "https://github.com/IlyaSemenov/eslint-plugin-import-remap/issues",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "imports",
    "autofix",
    "typescript"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "README.md",
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "lint": "biome check --write .",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "types": "tsc && tsc -p tests/tsconfig.json"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "^2.5.11",
    "@changesets/cli": "^2.31.1",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.4.0",
    "eslint": "^10.9.1",
    "publint": "^0.3.22",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
